# Copy this file to .env and replace every placeholder with your own values.
# Do not commit .env.

# Optional: omit DATABASE_URL to use the local SQLite database (rims.db).
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@DB_HOST:5432/DB_NAME

# Generate a long random secret for Flask sessions and CSRF signing.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development
